<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="RamDog" version="1.0.0.0" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- highestAvailable, e nao requireAdministrator: quem e admin sobe elevado (com
             o consentimento do UAC), e quem nao tem direito de elevar continua abrindo o
             RamDog limitado, em vez de nao conseguir abrir de jeito nenhum. -->
        <requestedExecutionLevel level="highestAvailable" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
