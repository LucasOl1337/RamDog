<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- asInvoker: herda o token do RamDog. Sem isso o CreateProcess falha com
       ERROR_ELEVATION_REQUIRED quando o app não está elevado, e a temp da CPU
       some da UI. Tctl/DIMM ainda só respondem com token de admin. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
